<mujoco model="fairino5_v6_right_specific_config">
  <contact>
    <pair geom1="right/geom_0_" geom2="right/geom_1_" name="right/base_shoulder" condim="1"/>
  </contact>

  <actuator>
    <general name="right/act1" joint="right/j1" class="size1" ctrlrange="-3.0543 3.0543" gainprm="150" biasprm="0 -150 -400"/>
    <general name="right/act2" joint="right/j2" class="size1" ctrlrange="-4.6251 1.4835" gainprm="700" biasprm="0 -700 -450"/>
    <general name="right/act3" joint="right/j3" class="size2" ctrlrange="-2.8274 2.8274" gainprm="200" biasprm="0 -200 -200"/>
    <general name="right/act4" joint="right/j4" class="size2" ctrlrange="-4.6251 1.4835" gainprm="23" biasprm="0 -23 -23"/>
    <general name="right/act5" joint="right/j5" class="size3" ctrlrange="-3.0543 3.0543" gainprm="23" biasprm="0 -23 -23"/>
    <general name="right/act6" joint="right/j6" class="size3" ctrlrange="-3.0543 3.0543" gainprm="23" biasprm="0 -23 -23"/>
    <general class="2f85" name="right/fingers_actuator" tendon="right/split" forcerange="-5 5" ctrlrange="0 255"
             gainprm="0.3137255 0 0" biasprm="0 -100 -10"/>
  </actuator>
  <sensor>
    <force name="right/force_sensor" site="right/force_sensor"/>
    <torque name="right/torque_sensor" site="right/force_sensor"/>
  </sensor>

  <contact>
    <exclude body1="right/gripper_base" body2="right/left_driver"/>
    <exclude body1="right/gripper_base" body2="right/right_driver"/>
    <exclude body1="right/gripper_base" body2="right/left_spring_link"/>
    <exclude body1="right/gripper_base" body2="right/right_spring_link"/>
    <exclude body1="right/right_coupler" body2="right/right_follower"/>
    <exclude body1="right/left_coupler" body2="right/left_follower"/>
  </contact>

  <tendon>
    <fixed name="right/split">
      <joint joint="right/right_driver_joint" coef="0.5"/>
      <joint joint="right/left_driver_joint" coef="0.5"/>
    </fixed>
  </tendon>

  <equality>
    <connect body1="right/right_follower" body2="right/right_coupler" anchor="0 0 0"
             solimp="0.95 0.99 0.001" solref="0.005 1"/>
    <connect body1="right/left_follower" body2="right/left_coupler" anchor="0 0 0"
             solimp="0.95 0.99 0.001" solref="0.005 1"/>
    <joint joint1="right/right_driver_joint" joint2="right/left_driver_joint"
           polycoef="0 1 0 0 0" solimp="0.95 0.99 0.001" solref="0.005 1"/>
  </equality>
</mujoco>